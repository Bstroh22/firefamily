{
  "expo": {
    "name": "SoCal FireFamily",
    "slug": "firefamily",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "firefamily",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.socalfirefamily.app",
      "config": { "usesNonExemptEncryption": false }
    },
    "android": {
      "package": "com.socalfirefamily.app",
      "adaptiveIcon": {
        "backgroundColor": "#031D3C",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SoCal FireFamily uses your photos so you can add pictures to listings, rentals, and your profile.",
          "cameraPermission": "SoCal FireFamily uses your camera so you can take photos for listings, rentals, and your profile."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SoCal FireFamily uses your location to show referrals near you."
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#031D3C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 280
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62e1fbb6-6394-4e7c-b290-6827fa44bf11"
      }
    },
    "owner": "b_stroh"
  }
}